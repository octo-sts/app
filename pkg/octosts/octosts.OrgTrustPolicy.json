    "OrgTrustPolicy": {
      "properties": {
        "issuer": {
          "type": "string",
          "description": "Issuer to match against (exact match)."
        },
        "issuer_pattern": {
          "type": "string",
          "description": "Issuer regex pattern to match against."
        },
        "subject": {
          "type": "string",
          "description": "Subject to match against (exact match)."
        },
        "subject_pattern": {
          "type": "string",
          "description": "Subject regex pattern to match against."
        },
        "audience": {
          "type": "string",
          "description": "Audience to match against (exact match)."
        },
        "audience_pattern": {
          "type": "string",
          "description": "Audience regex pattern to match against."
        },
        "claim_pattern": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "ClaimPattern is a map of claim names to regex patterns to match against."
        },
        "permissions": {
          "$ref": "#/$defs/InstallationPermissions",
          "description": "GitHub App installation permissions to request tokens with.\nSee https://docs.github.com/en/rest/apps/apps?apiVersion=2022-11-28#create-an-installation-access-token-for-an-app"
        },
        "app": {
          "type": "string",
          "description": "App pins exchanges to one configured app (name or numeric app ID)."
        },
        "app_pattern": {
          "type": "string",
          "description": "App name regex pattern; exchanges route among matching apps."
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Repositories is an optional scoping of repositories within the organization.\nIf not provided, all repositories available to the GitHub App within the organization\nare included."
        },
        "repository_ids": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "description": "RepositoryIDs scopes the token like Repositories, but by repository ID.\nIDs survive a rename, and a deleted repository's ID is never reused by\na new repository of the same name. At most one of Repositories and\nRepositoryIDs may be set."
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
